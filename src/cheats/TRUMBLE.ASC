10 MODE 1:PRINT"TRUMBLE SOUND TEST":PRINT"Same pitch, decay and length as the":PRINT"game's effects, via BASIC SOUND":PRINT
20 PRINT"1  squeak now in use (effect 13)"
30 PRINT"2  lock blip (effect 15)"
40 PRINT"3  key click (effect 7)"
50 PRINT"4  your own: period, ticks, volume"
60 PRINT"5  a crowd: 20 squeaks at random"
70 PRINT"Q  quit":PRINT
80 k$=UPPER$(INKEY$):IF k$="" THEN 80
90 IF k$="1" THEN p=100:n=14:v=15:GOSUB 500:GOTO 80
100 IF k$="2" THEN p=10:n=10:v=15:GOSUB 500:GOTO 80
110 IF k$="3" THEN p=40:n=10:v=15:GOSUB 500:GOTO 80
120 IF k$="4" THEN GOSUB 600:GOTO 80
130 IF k$="5" THEN GOSUB 700:GOTO 80
140 IF k$="Q" THEN END
150 GOTO 80
500 ENV 1,n,-1,2:SOUND 1,p,n*2,v,1:RETURN
600 INPUT"Tone period (squeak 100)";p
610 INPUT"Ticks 1-15 (squeak 14, 20 ms each)";n
620 INPUT"Start volume 1-15 (squeak 15)";v
630 n=MAX(1,MIN(15,n)):v=MAX(1,MIN(15,v)):GOSUB 500:RETURN
700 FOR i=1 TO 20:p=100:n=14:v=15:GOSUB 500
710 t=TIME+RND*200+30:WHILE TIME<t:WEND:NEXT:RETURN
