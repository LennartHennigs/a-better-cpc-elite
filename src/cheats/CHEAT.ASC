10 OPENOUT"d":MEMORY &83F:CLOSEOUT
20 MODE 1:INK 0,0:INK 1,24:BORDER 0
30 PRINT"ELITE CHEATS (ENTER=yes)":PRINT
40 RESTORE 500:DIM f(9)
50 READ t$:IF t$="*" THEN 90
60 PRINT t$;"? ";:GOSUB 400:j=j+1:f(j)=a
70 GOTO 50
90 PRINT"Unlimited hold? ";:GOSUB 400:h=25*(1-a)
100 PRINT"Own cloak? ";:GOSUB 400:m=64*a
110 INPUT"Cash Cr (100)";c$:c=VAL(c$):IF c<=0 THEN c=100
120 INPUT"Mission 0-3 (0)";s$:s=INT(VAL(s$)):IF s<0 OR s>3 THEN s=0
125 INPUT"Kills (<32768)";k$:INPUT"Jumps";w$:INPUT"Added mission 1-4";z$
130 INK 1,0:ON ERROR GOTO 160
140 LOAD"largeaxx",&840:LOAD"commonxx",&1A40
150 MEMORY &A000
160 LOAD"common2x",&C000
170 RESTORE 600:FOR j=1 TO 9:READ k
180 FOR i=1 TO k:READ x,y:IF f(j) THEN POKE x,y
190 NEXT:NEXT
200 POKE &998,h
210 c=INT(MIN(c,6.5E7)*10):u=INT(c/10000):v=c-u*1E4
220 POKE &39D9,u MOD 256:POKE &39DA,u\256:POKE &39DB,v MOD 256:POKE &39DC,v\256
230 n=31:IF s=2 THEN n=127 ELSE IF s=3 THEN n=253
240 IF s>0 THEN POKE &4E5D,0:POKE &39D6,n:m=m-(s>1)-2*(s>2)
242 w=MIN(INT(VAL(w$)),65535):IF w>0 THEN POKE &4E5D,0:POKE &39D6,w MOD 256:POKE &39D7,w\256
244 k=MIN(INT(VAL(k$)),32767):POKE &39D4,k MOD 256:POKE &39D5,k\256
246 z=VAL(z$):IF z>0 THEN POKE &39F9,2-44*(z>1)-48*(z>2):IF z>3 THEN POKE &39FA,3
250 POKE &3A23,m:CALL &1C82
400 a$=UPPER$(INKEY$):IF a$=CHR$(13) THEN a$="Y"
410 IF a$="N" OR a$="Y" THEN a=-(a$="Y"):PRINT a$:RETURN ELSE 400
500 DATA Shield+fuel,Missiles,Hyperjump,Missile v stn,Laser heat,Gal jump,One-hit,Energy bomb,Pirate board,*
600 DATA 2,&4F02,0,&35CB,0,1,&382D,0,2,&4C08,0,&4C12,0,1,&8A8F,0,1,&7A4F,0,1,&4BFA,0,1,&7AA8,0,1,&2F6A,0,1,&207D,&C9
