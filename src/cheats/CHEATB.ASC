1 OPENOUT"d":MEMORY &83F:CLOSEOUT:INK 1,0:ON ERROR GOTO 5
2 LOAD"largeaxx",&840:LOAD"commonxx",&1A40
3 MEMORY &A000
5 LOAD"common2x",&C000
10 DIM a%(13):RESTORE 800:FOR b=1 TO 4:FOR i=1 TO 13:READ a%(i):NEXT
20 IF PEEK(a%(1))=2 AND PEEK(a%(6))=&13 AND PEEK(a%(6)-2)=4 THEN 40
30 NEXT:GOTO 100
40 y=a%(12):g=a%(13):p=0
50 FOR j=1 TO 9:FOR i=1 TO 1-(j=1)-(j=3):p=p+1:IF f(j) THEN POKE a%(p),-201*(j=9)
60 NEXT:NEXT
70 POKE &998,h:POKE g+92,m
71 IF d THEN POKE g+56,d
72 POKE g+18,u MOD 256:POKE g+19,u\256:POKE g+20,v MOD 256:POKE g+21,v\256
74 IF s>0 THEN POKE y,0:POKE g+15,n
76 IF w>0 THEN POKE y,0:POKE g+15,w MOD 256:POKE g+16,w\256
78 POKE g+13,k MOD 256:POKE g+14,k\256
80 IF z>0 THEN POKE g+50,2-44*(z>1)-48*(z>2):IF z>3 THEN POKE g+51,3
100 CALL &1C82
800 DATA &4F02,&35CB,&382D,&4C08,&4C12,&8A8F,&7A4F,&4BFA,&7AA8,&2F6A,&207D,&4E5D,&39C7
810 DATA &5016,&36D2,&3934,&4D1C,&4D26,&8BD7,&7B96,&4D0E,&7BEF,&2F6A,&207D,&4F71,&3ACE
820 DATA &5054,&369C,&38FE,&4D5A,&4D64,&8C2E,&7BEF,&4D4C,&7C48,&2F6A,&207D,&4FAF,&3A98
830 DATA &CE04,&35CB,&382D,&CB0A,&CB14,&8A7D,&F953,&CAFC,&F9AC,&2F6A,&207D,&CD5F,&39C7
